# Copy to .env (git-ignored). No secrets are needed: ClinicalTrials.gov is public and the LLM runs locally.
LLM_PROVIDER=ollama          # ollama | transformers
LLM_MODEL=qwen3:4b           # Ollama tag, or a Hugging Face id such as Qwen/Qwen3-1.7B for transformers
OLLAMA_URL=http://localhost:11434
CTGOV_CACHE=replay           # replay (offline, reproducible) | record (fill eval/cache) | live
